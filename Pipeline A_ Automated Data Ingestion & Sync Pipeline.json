    {
      "parameters": {
        "jsCode": "const chunkSize = 500;\nconst overlap = 50;\n\nconst output = [];\n\nfor (const item of $input.all()) {\n\n    const text = item.json.text || \"\";\n\n    for (let i = 0; i < text.length; i += (chunkSize - overlap)) {\n\n        output.push({\n            json: {\n                text: text.substring(i, i + chunkSize),\n                chunkNumber: output.length + 1,\n                author: item.json.info?.Author || \"\",\n                creator: item.json.info?.Creator || \"\",\n                createdDate: item.json.info?.CreationDate || \"\"\n            }\n        });\n\n    }\n}\n\nreturn output;"
      },
